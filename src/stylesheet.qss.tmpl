/* ==========================================================================
   Noorjahan $variant  -  qBittorrent 5.x theme (Qt 6, Fusion style)
   Copper-patina teal on warm stone.  Generated by build.py, do not edit by hand.

   Tokens
     canvas   $canvas   window background, shows in the 8px gaps between cards
     card     $card     top bar, sidebar, transfer list, details panel, group boxes
     field    $field    every input, drop-down and push button
     line     $line     1px card outlines (stylesheets have no shadows)
     accent   $accent   checked boxes, default button, focus, open tab
     text     $text / $text2 / $text3, disabled $disabled
     radii    12 cards, 8 inputs / buttons / highlights, 5 check boxes

   Geometry (verified against qBittorrent 5.3.0 sources):
     MainWindow's central layout has fixed margins L7 T3 R5 B0 and 4px splitter
     handles; the margins below top them up to an even 8px everywhere.
   ========================================================================== */

* {
    font-family: "Inter", "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 10pt;
    font-weight: $bodyWeight;  /* Medium in both: Qt hints Inter Regular to thin 1px stems; Medium reads like the browser renders Regular */
    outline: none;
}

QWidget {
    color: $text;
    selection-background-color: $selStrong;
    selection-color: $text;
    directory-icon: url(":/uitheme/icons/folder-documents.svg");
    directory-open-icon: url(":/uitheme/icons/folder-documents.svg");
    directory-closed-icon: url(":/uitheme/icons/folder-documents.svg");
    file-icon: url(":/uitheme/icons/fileicon.svg");
    messagebox-warning-icon: url(":/uitheme/icons/dialog-warning.svg");
    messagebox-critical-icon: url(":/uitheme/icons/error.svg");
    lineedit-clear-button-icon: url(":/uitheme/ui/close.svg");
}

QWidget:disabled {
    color: $disabled;
}

FileSystemPathEdit > QToolButton {
    qproperty-icon: url(":/uitheme/icons/folder-documents.svg");
}

ShutdownConfirmDialog #warningLabel {
    qproperty-pixmap: url(":/uitheme/ui/warning-32.svg");
}

OptionsDialog #deleteTorrentWarningIcon {
    max-width: 0px;
    margin: 0;
}

OptionsDialog #deleteTorrentWarningLabel {
    background-image: url(":/uitheme/ui/warning-16.svg");
    background-repeat: no-repeat;
    background-position: left center;
    padding-left: 22px;
    color: $err;
}

QMainWindow,
QDialog,
MainWindow #centralWidget {
    background-color: $canvas;
}

QMainWindow::separator {
    background: $canvas;
    width: 1px;
    height: 1px;
}

/* ============================================================ ITEM VIEWS == */

QAbstractItemView {
    background-color: $card;
    alternate-background-color: $alt;
    border: 1px solid $line;
    border-radius: 12px;
    color: $text;
    selection-background-color: $sel;
    selection-color: $text;
    show-decoration-selected: 1;
}

QAbstractItemView::item {
    padding: 4px 6px;
    border: none;
}

QAbstractItemView::item:hover {
    background-color: $hover;
}

QAbstractItemView::item:selected {
    background-color: $sel;
    color: $text;
}

MainWindow QAbstractItemView,
PropertiesWidget QAbstractItemView {
    border: none;
    border-radius: 0;
}

QDialog QAbstractItemView {
    padding: 4px;
}

QDialog QGroupBox QAbstractItemView {
    background-color: $field;
    alternate-background-color: $field;
    border-color: $line;
}

QTreeView {
    qproperty-allColumnsShowFocus: false;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(":/uitheme/ui/chevron-right.svg");
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(":/uitheme/ui/chevron-down.svg");
}

QTreeView::branch:selected {
    background-color: $sel;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: transparent;
    color: $text;
    font-weight: 500;
    border: none;
    margin: 6px 0;
    padding: 2px 8px;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    color: $text2;
}

/* Sort mark, Windows 11 Explorer style: a small chevron centred above the
   sorted column's title, in the header's top band, so it never touches a title
   (Qt reserves no room beside the label: there it clips or erases text).
   Qt draws ::up-arrow for ascending order (verified), so ^ = A..Z / small..large. */
QHeaderView::up-arrow {
    image: url(":/uitheme/ui/sort-up.svg");
    width: 10px;
    height: 10px;
    subcontrol-origin: margin;
    subcontrol-position: top center;
    top: 1px;
}

QHeaderView::down-arrow {
    image: url(":/uitheme/ui/sort-down.svg");
    width: 10px;
    height: 10px;
    subcontrol-origin: margin;
    subcontrol-position: top center;
    top: 1px;
}

QTableView {
    gridline-color: $line2;
}

QTableCornerButton::section {
    background-color: transparent;
    border: none;
}

/* ============================================================ SCROLLBARS == */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 3px 2px 3px 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 3px 2px 3px;
}

QScrollBar::handle {
    background-color: $scroll;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    min-height: 36px;
}

QScrollBar::handle:horizontal {
    min-width: 36px;
}

QScrollBar::handle:hover {
    background-color: $scrollHover;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

QAbstractScrollArea::corner {
    background: transparent;
}

/* ================================================================ TOP BAR == */

/* The menu bar is the top half of one card and the toolbar the bottom half.
   Qt lays menu items out from the bar's own edge, so the card is drawn with
   padding + background-clip; the outline is drawn as a left/right/top border
   on the menu bar and left/right/bottom on the toolbar so they join seamlessly. */
QMenuBar {
    background-color: transparent;
    border: none;
    margin: 0 0 0 6px;
    /* header rhythm, 12px each: title bar -> menu pill -> toolbar boxes ->
       panels. A top margin doesn't move the items; padding does. 42 = 6 padding
       + 6 Qt inset + 24 pill + 6 (4px popup gap + 2px slack). Items taller than
       the cap fold into the hidden "…" overflow and leave an EMPTY bar, so keep
       the slack: without Inter (Segoe UI on Windows 10, Segoe UI Variable on 11)
       the pill is ~1px taller. Tested 100/125/150%, windows11 + windowsvista. */
    padding: 6px 0 0 0;
    spacing: 2px;
    max-height: 42px;
}

/* popups open at the bottom of the item's slot, so the bottom margin is the gap
   between the hover pill and the menu. 4px (not 6) leaves the menu bar room for
   fallback fonts; with Inter the closed window is pixel-identical either way */
QMenuBar::item {
    background: transparent;
    color: $text2;
    padding: 4px 10px;
    margin: 0 0 4px 0;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: $hover;
    color: $text;
}

QMenuBar::item:pressed {
    background-color: $sel;
    color: $text;
}

/* Popups fill their window edge to edge. With Style=windows11 Windows rounds the
   popup window and draws its own hairline + shadow; a CSS border or margin here
   would show as a second, square outline. */
QMenu {
    background-color: $card;
    border: none;
    border-radius: 0;
    /* vertical padding only: Qt opens a submenu at the right edge of the item's
       action rect, and the menu's side padding sits outside that rect, so 6px of
       side padding made every submenu (View > Log, Lock, a torrent's Copy...)
       open over its parent. The 6px inset lives on the items instead. */
    padding: 6px 0;
    margin: 0;
}

QMenu::item {
    background: transparent;
    color: $text;
    padding: 6px 28px 6px 10px;
    border-radius: 8px;
    margin: 1px 6px;
    min-height: 18px;
}

QMenu::item:selected {
    background-color: $sel;
}

QMenu::item:disabled {
    color: $disabled;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: $line2;
    margin: 5px 14px;
}

/* on/off items show a real check box in the icon slot: empty when off */
QMenu::indicator {
    width: 16px;
    height: 16px;
    padding-left: 8px;
}

QMenu::indicator:non-exclusive {
    width: 14px;
    height: 14px;
    margin-left: 9px;
    padding: 0;
    background-color: $field;
    border: 1px solid $boxLine;
    border-radius: 4px;
}

QMenu::indicator:non-exclusive:checked {
    background-color: $accent;
    border-color: $accent;
    image: url(":/uitheme/ui/check.svg");
}

QMenu::indicator:exclusive:checked {
    image: url(":/uitheme/ui/menu-radio.svg");
}

/* "Automatic Torrent Management" / "Super seeding mode" are qBittorrent's own
   TriStateWidget (a painted check box inside the menu): give it the same box,
   the same 30px row and the same text line as icon items */
TriStateWidget {
    background: transparent;
    min-height: 32px;
}

TriStateWidget::item {
    background: transparent;
    color: $text;
    padding: 6px 28px 6px 10px;
    border-radius: 8px;
    margin: 1px 6px;
}

TriStateWidget::item:selected {
    background-color: $sel;
}

TriStateWidget::icon {
    padding-left: 8px;
}

TriStateWidget::indicator {
    width: 16px;
    height: 16px;
    padding-left: 5px;
}

TriStateWidget::indicator:unchecked {
    image: url(":/uitheme/ui/menu-box.svg");
}

TriStateWidget::indicator:checked {
    image: url(":/uitheme/ui/menu-box-on.svg");
}

TriStateWidget::indicator:indeterminate {
    image: url(":/uitheme/ui/menu-box-mixed.svg");
}

QMenu::right-arrow {
    image: url(":/uitheme/ui/chevron-right.svg");
    width: 14px;
    height: 14px;
    padding-right: 6px;
}

/* note: Qt uses the *left* padding as the toolbar frame on all four sides */
QToolBar {
    background-color: $card;
    border: none;
    padding: 5px;
    spacing: 2px;
    qproperty-iconSize: 20px 20px;
}

/* bottom half of the top card; the 3px bottom margin + the central layout's
   3px top margin + the sidebar's 2px top margin = 8px gap below the card */
/* no frame: Qt applies a toolbar's padding (and border) to all four sides,
   which would add to the 12px rhythm above and below. The 8px side insets
   come from the first and last items instead (below) */
MainWindow > QToolBar {
    background-color: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

/* first icon: its pill starts on the panels' left edge (8 + its 1px margin) */
QToolBar QToolButton[text="Open"] {
    margin-left: 9px;
}

/* the lock (last item): 8px after the filter drop-down; with the toolbar's
   right margin at 0 its pill ends on the card edge below, like "File" and the
   first icon start on the left card edge */
QToolBar QToolButton[text="Lock"] {
    margin: 6px 8px 6px 9px;
    padding: 6px 26px 6px 0;  /* 32px tall. Qt centres the padlock between the left padding and the chevron segment, so no left padding and a fixed width centre it */
    min-width: 28px;
    max-width: 28px;
}

/* split pill: a 28px padlock segment and a 20px chevron
   segment, each glyph centred in its own segment; the chevron segment takes
   the toolbar's lighter hover shade and the pill's 10px outer corners */
QToolBar QToolButton[text="Lock"]::menu-button {
    width: 20px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QToolBar QToolButton[text="Lock"]::menu-arrow {
    position: relative;
    left: 0;
}


QToolBar::separator {
    background-color: $line;
    width: 1px;
    margin: 7px 8px;
}

QToolBar::handle {
    width: 0;
    image: none;
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 6px 8px 5px 9px;  /* 40 x 34 pill, the filter box's height: the 18px icon sits dead centre */
    margin: 0 1px;
    color: $text;
}

QToolBar QToolButton:hover {
    background-color: $hover;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: $sel;
}

QToolBar QToolButton[popupMode="MenuButtonPopup"] {
    padding-right: 19px;
}

QToolBar QToolButton::menu-button {
    border: none;
    width: 16px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QToolBar QToolButton::menu-button:hover {
    background-color: $hover;
}

QToolBar QToolButton::menu-arrow {
    image: url(":/uitheme/ui/chevron-down.svg");
    width: 12px;
    height: 12px;
}

/* torrent filter box: qBittorrent fixes its width at 200px in code */
QToolBar QLineEdit {
    background-color: $field;
    border: 1px solid $line;
    border-radius: 10px;
    padding: 0 10px 0 6px;
    min-height: 32px;
    max-height: 32px;
    min-width: 280px;
    color: $text;
}

QToolBar QLineEdit:hover {
    border-color: $lineStrong;
}

QToolBar QLineEdit:focus {
    border-color: $accent;
}

/* "Filter by:" ~12px from the search box and from the drop-down (the
   container's spacing + 2px) */
QToolBar QLabel {
    color: $text3;
    padding: 0 2px;
}

QToolBar QComboBox {
    background-color: $field;
    border: 1px solid $line;
    border-radius: 10px;
    color: $text;
    padding: 0 14px 0 12px;
    margin: 6px 0;  /* its list opens 6px below the box */
    min-width: 60px;
    min-height: 32px;
    max-height: 32px;
}

QToolBar QComboBox:hover {
    border-color: $lineStrong;
}

QToolBar QComboBox::drop-down {
    border: none;
    width: 16px;
    subcontrol-position: center right;
    right: 8px;
}

/* ----------------------------------------------------- main tab widget */
/* (Transfers / Search / RSS / Log tabs, only shown when those are enabled) */

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget::tab-bar {
    left: 8px;
}

/* Search and RSS pages have Qt's own 9px layout inset, which put their cards
   8px inside the status bar and the transfer cards. The page is pulled out by
   that inset (7 + 1 left, 5 + 1 right of the central layout's margins), so
   every page's cards share the status bar's edges; the Transfers page gets the
   difference back on its splitter (so it holds with the sidebar hidden too).
   Applies only while the tab bar is shown. */
MainWindow #centralWidget > QTabWidget::pane {
    margin: 0px -6px 0px -8px;
}

#centralWidget > QTabWidget > QStackedWidget > QSplitter {
    margin: 0px 6px 0px 8px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: $text2;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 14px;
    margin: 4px 2px;
}

QTabBar::tab:hover {
    background-color: $hover;
    color: $text;
}

QTabBar::tab:selected {
    background-color: $card;
    border-color: $line;
    color: $text;
}

QTabBar::close-button {
    image: url(":/uitheme/ui/close.svg");
    subcontrol-position: right;
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

QTabBar::close-button:hover {
    image: url(":/uitheme/ui/close-hover.svg");
}

QTabBar::scroller {
    width: 48px;
}

QTabBar QToolButton {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 6px;
    padding: 0;
    margin: 4px 1px;
}

QTabBar QToolButton:hover {
    background-color: $hover;
    border-color: $lineStrong;
}

QTabBar QToolButton::left-arrow {
    image: url(":/uitheme/ui/chevron-left.svg");
    width: 14px;
    height: 14px;
}

QTabBar QToolButton::left-arrow:disabled {
    image: url(":/uitheme/ui/chevron-left-disabled.svg");
}

QTabBar QToolButton::right-arrow {
    image: url(":/uitheme/ui/chevron-right.svg");
    width: 14px;
    height: 14px;
}

QTabBar QToolButton::right-arrow:disabled {
    image: url(":/uitheme/ui/chevron-right-disabled.svg");
}

/* --------------------------------------------------------------- splitters */

MainWindow QSplitter {
    background-color: $canvas;
}

QSplitter::handle {
    background-color: $canvas;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

/* ================================================================ SIDEBAR == */

TransferListFiltersWidget {
    min-width: 236px;
}

/* the sidebar card: 1 + central 7 = 8px from the window edge, 4 + 4px handle =
   8px to the transfer list, 8px above the status bar */
TransferListFiltersWidget QScrollArea {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    margin: 2px 4px 8px 1px;
    padding: 4px 0;
}

TransferListFiltersWidget QScrollArea > QWidget,
TransferListFiltersWidget QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* section headers ("Status", "Categories", ...): the check indicator draws the
   chevron and is stretched across the row so it lands on the right edge */
TransferListFiltersWidget QCheckBox {
    color: $text;
    font-size: 10.5pt;
    font-weight: 700;
    text-transform: none;
    padding: 12px 0 6px 18px;
    spacing: -199px;
    min-width: 209px;
}

TransferListFiltersWidget QCheckBox::indicator {
    width: 199px;
    height: 18px;
    background: transparent;
    border: none;
}

/* qBittorrent paints these headers itself and asks for a tree "branch" arrow */
TransferListFiltersWidget QCheckBox::branch:open {
    image: url(":/uitheme/ui/section-open.svg");
    image-position: right center;
}

TransferListFiltersWidget QCheckBox::branch:closed {
    image: url(":/uitheme/ui/section-closed.svg");
    image-position: right center;
}

TransferListFiltersWidget QCheckBox:hover {
    color: $text2;
}

/* the sidebar scrolls with the wheel; no track, so the section chevrons keep
   the same 21px inset as the titles whether the lists overflow or not */
TransferListFiltersWidget QScrollBar:vertical {
    width: 0;
    margin: 0;
}

/* filter items: 32px pills, 1px apart, inset 8px from the card edges */
TransferListFiltersWidget QListView,
TransferListFiltersWidget QTreeView {
    background-color: transparent;
    alternate-background-color: transparent;
    border: none;
    padding: 0;
    min-width: 214px;
    qproperty-iconSize: 18px 18px;
    show-decoration-selected: 1;
}

TransferListFiltersWidget QListView::item,
TransferListFiltersWidget QTreeView::item {
    color: $text;
    background: transparent;
    border: none;
    border-radius: 8px;
    height: 22px;
    padding: 5px 10px 5px 10px;
    margin: 1px 8px;
}

TransferListFiltersWidget QListView::item:hover,
TransferListFiltersWidget QTreeView::item:hover {
    background-color: $hover;
}

TransferListFiltersWidget QListView::item:selected,
TransferListFiltersWidget QTreeView::item:selected {
    background-color: $sel;
    color: $text;
}

TransferListFiltersWidget QTreeView::branch,
TransferListFiltersWidget QTreeView::branch:selected {
    background-color: transparent;
}

/* ========================================================= TRANSFER LIST == */

/* the list is its own card: 2px top margin lines it up with the sidebar,
   3 + central 5 = 8px from the right edge; the bottom padding keeps the
   viewport clear of the rounded corners */
MainWindow QSplitter TransferListWidget {
    background-color: $card;
    alternate-background-color: $card;
    border: 1px solid $line;
    border-radius: 14px;
    margin: 2px 3px 0 0;
    padding: 4px 6px 6px 6px;
    qproperty-iconSize: 16px 16px;
}

/* scrollbars get their own lane along the card's edge, split from the rows by
   a hairline; the thumb floats in it with no track */
MainWindow QSplitter TransferListWidget QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 10px;
    margin: 0;
    padding: 4px 1px 4px 1px;
}

MainWindow QSplitter TransferListWidget QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 10px;
    margin: 0;
    padding: 1px 4px 1px 4px;
}

MainWindow QSplitter TransferListWidget QScrollBar::handle {
    border-radius: 4px;
}

/* no 'color' here: row text colours come from config.json (TransferList.*).
   Options > Behavior > "Use different text colors by torrent states" turns
   them into plain text. */
MainWindow QSplitter TransferListWidget::item {
    border: none;
    height: 24px;
    padding: 7px 8px;
    margin: 2px 0;
}

MainWindow QSplitter TransferListWidget::item:hover {
    background-color: $hover;
}

MainWindow QSplitter TransferListWidget::item:selected {
    background-color: $sel;
}

/* each cell paints its own highlight; round the row's two ends */
MainWindow QSplitter TransferListWidget::item:first {
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
}

MainWindow QSplitter TransferListWidget::item:last {
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

MainWindow QSplitter TransferListWidget::item:only-one {
    border-radius: 8px;
}

/* the header line sits 4px above the header's edge, so the first row's
   highlight has room under it (4 + the row's own 2px margin = 6px) */
MainWindow QSplitter TransferListWidget QHeaderView {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid $line;
    margin-bottom: 4px;
}

MainWindow QSplitter TransferListWidget QHeaderView::section:last {
    border-right: none;
}

MainWindow QSplitter TransferListWidget QHeaderView::section {
    color: $text;
    font-weight: 500;
    font-size: 9pt;
    border: none;
    border-right: 1px solid $colsep;
    margin: 10px 0 6px 0;
    padding: 0 8px;
}

MainWindow QSplitter TransferListWidget QHeaderView::section:hover {
    color: $text2;
}


/* In-cell progress bars are drawn through a hidden QProgressBar. qBittorrent 5.3
   hands each row's state colour to the style (downloading blue, seeding green...),
   so the chunk is left to the style; a stylesheet chunk would hide that colour.
   The stylesheet draws the % label in one colour, which can't stay readable on a
   full-strength fill, so the bar is a 5px line under the label: Qt centres the
   label on the whole cell, the margins push the line to the bottom of the cell. */
QProgressBar {
    background-color: $groove;
    border: none;
    border-radius: 2px;
    color: $text;
    text-align: center;
    margin: 29px 8px 6px 8px;
}

/* QProgressBar::chunk has no rule of its own on purpose: it falls through to the
   style, which paints it with the per-row colour qBittorrent 5.3 sets */

QProgressBar::chunk:disabled {
    border-radius: 2px;
    background-color: $lineStrong;
}

QProgressBar:disabled {
    color: $text3;
}

/* real progress bars inside dialogs keep their full size */
QWidget QProgressBar {
    margin: 0;
    min-height: 18px;
}

/* ====================================================== DETAILS PANEL == */

/* PropertiesWidget only paints a background with auto-fill on; it stays canvas.
   The pages (QStackedWidget) are the card; the tab buttons sit under it. */
PropertiesWidget {
    background-color: $canvas;
    qproperty-autoFillBackground: true;
}

/* the tab bar is a bare layout of QPushButtons (no container to draw on).
   Left margin 0 keeps the first button flush with the card, right margin 3
   flushes "Speed" with the card's right edge; 3px layout spacing between. */
/* The tab bar is a bare layout of QPushButtons with a fixed 3px spacing (no
   widget to draw a track on, and negative margins are ignored), so the tabs are
   one group of matching pills: filled resting state, the open one raised.
   Every pill keeps a 1px border so nothing shifts when the open tab changes. */
PropertiesWidget > QPushButton {
    background-color: $field;
    color: $text2;
    border: 1px solid $line;
    border-radius: 10px;
    padding: 6px 14px;
    /* the bar lays the pills out 3px apart; 5px more makes an 8px gap, the same
       as the 8px between the card above and the pills */
    margin: 3px 5px 4px 0;
    min-height: 18px;
    /* each pill gets a copy of its icon with 4px of air on the right (Qt fixes
       the icon-to-text gap at 4px, so the gap is 8px); in other languages the
       text selectors below don't match and the stock icon is used */
    qproperty-iconSize: 20px 16px;
}

PropertiesWidget > QPushButton[text="General"] { qproperty-icon: url(":/uitheme/ui/pill-help-about.svg"); }
PropertiesWidget > QPushButton[text="Trackers"] { qproperty-icon: url(":/uitheme/ui/pill-trackers.svg"); }
PropertiesWidget > QPushButton[text="Peers"] { qproperty-icon: url(":/uitheme/ui/pill-peers.svg"); }
PropertiesWidget > QPushButton[text="HTTP Sources"] { qproperty-icon: url(":/uitheme/ui/pill-network-server.svg"); }
PropertiesWidget > QPushButton[text="Content"] { qproperty-icon: url(":/uitheme/ui/pill-directory.svg"); }

/* "Speed" ends on the card's right edge (the card has a 3px right margin) */
PropertiesWidget > QPushButton[text="Speed"] {
    margin-right: 3px;
    qproperty-icon: url(":/uitheme/ui/pill-chart-line.svg");
}

PropertiesWidget > QPushButton:hover {
    color: $text;
}

/* the open tab: qBittorrent holds its button down (setDown), which Qt styles as :pressed */
PropertiesWidget > QPushButton:pressed {
    background-color: $accentSoft;
    border-color: $accentLine;
    color: $accentText;
}

/* the details card: 4 + 4px handle = 8px below the list, right edge in line */
PropertiesWidget > QStackedWidget {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    margin: 4px 3px 0 0;
    padding: 8px;
}

PropertiesWidget QStackedWidget > QWidget,
PropertiesWidget QScrollArea,
PropertiesWidget QScrollArea > QWidget,
PropertiesWidget QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

PropertiesWidget QAbstractItemView,
PropertiesWidget QHeaderView,
PropertiesWidget QTextEdit {
    background-color: $card;
    alternate-background-color: $card;
}

PropertiesWidget QTextEdit {
    border: none;
}

/* as in the transfer list: the line sits 4px above the header's edge, so the
   first row's highlight starts 6px under it */
PropertiesWidget QHeaderView {
    border: none;
    border-bottom: 1px solid $line;
    margin-bottom: 4px;
}

PropertiesWidget QHeaderView::section {
    color: $text;
    font-weight: 500;
    font-size: 9pt;
    border: none;
    border-right: 1px solid $colsep;
    margin: 8px 0 8px 0;
    padding: 0 8px;
}

PropertiesWidget QHeaderView::section:last {
    border-right: none;
}

PropertiesWidget QTreeView::item:first {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

PropertiesWidget QTreeView::item:last {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

PropertiesWidget QTreeView::item:only-one {
    border-radius: 8px;
}

PropertiesWidget QTreeView {
    show-decoration-selected: 0;
}

/* the expand-arrow column is painted with the card: otherwise the Windows 11
   style draws its own selection box and accent bar there, a second shape
   beside the row pill */
PropertiesWidget QTreeView::branch,
PropertiesWidget QTreeView::branch:hover,
PropertiesWidget QTreeView::branch:selected {
    background-color: $card;
}

/* "Transfer" / "Information" sections inside the card: titles only, no box */
PropertiesWidget QGroupBox {
    background-color: transparent;
    border: none;
    margin-top: 24px;
    padding: 4px 0 0 0;
    font-size: 10.5pt;
    font-weight: 700;
}

PropertiesWidget QGroupBox QWidget {
    font-weight: normal;
}

PropertiesWidget QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 4px;
    padding: 0;
    color: $text;
}

/* field names muted, values in full text colour */
PropertiesWidget QGroupBox QLabel,
PropertiesWidget #labelDownloadedPieces,
PropertiesWidget #labelPiecesAvailability {
    color: $text3;
}

PropertiesWidget #labelElapsedVal, PropertiesWidget #labelETAVal, PropertiesWidget #labelConnectionsVal,
PropertiesWidget #labelDlTotalVal, PropertiesWidget #labelUpTotalVal, PropertiesWidget #labelSeedsVal,
PropertiesWidget #labelDlSpeedVal, PropertiesWidget #labelUpSpeedVal, PropertiesWidget #labelPeersVal,
PropertiesWidget #labelDlLimitVal, PropertiesWidget #labelUpLimitVal, PropertiesWidget #labelWastedVal,
PropertiesWidget #labelShareRatioVal, PropertiesWidget #labelReannounceInVal,
PropertiesWidget #labelLastSeenCompleteVal, PropertiesWidget #labelPopularityVal,
PropertiesWidget #labelTotalSizeVal, PropertiesWidget #labelTotalPiecesVal, PropertiesWidget #labelCreatedByVal,
PropertiesWidget #labelAddedOnVal, PropertiesWidget #labelCompletedOnVal, PropertiesWidget #labelCreatedOnVal,
PropertiesWidget #labelPrivateVal, PropertiesWidget #labelHashVal, PropertiesWidget #labelInfohash1Val,
PropertiesWidget #labelInfohash2Val, PropertiesWidget #labelSavePathVal, PropertiesWidget #labelCommentVal,
PropertiesWidget #labelProgressVal, PropertiesWidget #labelAverageAvailabilityVal {
    color: $text;
}

PropertiesWidget SpeedPlotView {
    background-color: $card;
    border: none;
}

/* every list in the details panel uses the transfer list's rows: 42px apart,
   4px between highlights, so a selection and a hover stay separate pills */
TorrentContentWidget::item,
TrackerListWidget::item,
PeerListWidget::item,
PropertiesWidget QListWidget::item {
    height: 24px;
    padding: 7px 6px;
    margin: 2px 0;
}

PropertiesWidget QListWidget::item {
    border-radius: 9px;
}

/* ============================================================= STATUS BAR == */

/* the status bar is one footer card, inset 8px like the panels above it.
   It ignores margins, so the card is a 9-slice image (build.py). Qt adds 3px
   above the items, so the bottom slice is 3px deeper than the top one
   (9 + 3 = 12 = 20 - 8 clear) and the items sit centred: 11px each side */
QStatusBar {
    background: transparent;
    border-image: url(":/uitheme/ui/statusbar-card.svg") 9 17 20 17 stretch stretch;
    border-width: 9px 17px 20px 17px;
    color: $text2;
    min-height: 19px;
}

QStatusBar::item {
    border: none;
}

/* text items (free space, external IP, DHT nodes) and restart warning icon:
   16px height fits 16x16 pixmaps without clipping while keeping the 30px box
   and 4px vertical lift (3 + 16 + 11 = 30) */
QStatusBar QLabel {
    color: $text2;
    background: transparent;
    border-style: solid;
    border-color: transparent;
    border-width: 3px 8px 11px 0;
    padding: 0 12px;
    min-height: 16px;
    max-height: 16px;
}

/* items only as wide as their text (qBittorrent reserves 200px per speed).
   Qt centres them in the whole bar, which includes the 8px clear strip under
   the card, and ignores their margins. The border is 8px deeper at the bottom
   than the top, which lifts what is drawn by 4px onto the card's centre line;
   hover and press paint a pill into the same border (build.py) */
QStatusBar QPushButton {
    qproperty-flat: false;
    background: transparent;
    color: $text2;
    border-style: solid;
    border-color: transparent;
    border-width: 4px 18px 12px 10px;
    border-radius: 0;
    padding: 0;
    margin: 0 2px;
    min-height: 14px;
    max-height: 14px;
    min-width: 0;
    qproperty-minimumWidth: 0;
}

QStatusBar QPushButton:hover {
    border-image: url(":/uitheme/ui/status-hover.svg") 4 18 12 10 stretch stretch;
    background-color: transparent;
    color: $text;
}

QStatusBar QPushButton:pressed {
    border-image: url(":/uitheme/ui/status-press.svg") 4 18 12 10 stretch stretch;
    background-color: transparent;
    color: $accentText;
}

QStatusBar QFrame[frameShape="VLine"],
QStatusBar QFrame[frameShape="5"] {
    border: none;
    background: $line;
    background-clip: padding;
    border-top: 1px solid transparent;
    border-bottom: 9px solid transparent;
    /* every item carries 8px clear on its right (so the last one stays inside
       the card); the divider takes 8px clear on its right too, so it sits
       centred between the pills (Qt ignores margins here) */
    border-right: 8px solid transparent;
    min-width: 1px;
    max-width: 1px;
    min-height: 14px;
    max-height: 14px;
    margin: 0;
}

/* =============================================================== BUTTONS == */

QPushButton {
    background-color: $card;
    color: $text;
    border: 1px solid $line;
    border-radius: 10px;
    padding: 6px 16px;
    min-height: 18px;
}

QPushButton:hover {
    border-color: $lineStrong;
    background-color: $field;
}

QPushButton:pressed {
    background-color: $sel;
}

QPushButton:checked {
    background-color: $selSolid;
    border-color: $accentLine;
}

QPushButton:default {
    background-color: $prim;
    border-color: $prim;
    color: $onPrim;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: $primHover;
    border-color: $primHover;
}

QPushButton:disabled {
    background-color: transparent;
    border-color: $line;
    color: $disabled;
}

QPushButton:flat {
    background: transparent;
    border: none;
}

QPushButton::menu-indicator {
    image: url(":/uitheme/ui/chevron-down.svg");
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    height: 12px;
    right: -6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px;
    color: $text;
}

QToolButton:hover {
    background-color: $hover;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: $sel;
}

QToolButton::menu-indicator {
    image: url(":/uitheme/ui/chevron-down.svg");
    width: 10px;
    height: 10px;
    subcontrol-position: bottom right;
}

QDialogButtonBox {
    button-layout: 0;
}

/* ================================================================ INPUTS == */

QLineEdit,
QAbstractSpinBox,
QTextEdit,
QPlainTextEdit {
    background-color: $field;
    color: $text;
    border: 1px solid $line;
    border-radius: 8px;
    padding: 5px 10px;
}

QTextEdit,
QPlainTextEdit {
    padding: 6px 8px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: $lineStrong;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: $accent;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: transparent;
    color: $disabled;
    border: 1px dashed $disLine;
}

QLineEdit:read-only {
    background-color: transparent;
}

QTextBrowser {
    background-color: $card;
    border: none;
}

/* the spin box's inner editor adds its own ~5px, so 5px here starts the text
   where a combo box's text starts (10px) */
QAbstractSpinBox {
    padding-left: 5px;
    padding-right: 26px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: $hover;
}

QAbstractSpinBox::up-arrow {
    image: url(":/uitheme/ui/chevron-up.svg");
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::down-arrow {
    image: url(":/uitheme/ui/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(":/uitheme/ui/chevron-up-disabled.svg");
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(":/uitheme/ui/chevron-down-disabled.svg");
}

QComboBox {
    background-color: $field;
    color: $text;
    border: 1px solid $line;
    border-radius: 8px;
    padding: 5px 28px 5px 10px;
    min-height: 18px;
    combobox-popup: 0;
}

QComboBox:hover {
    border-color: $lineStrong;
}

QComboBox:on,
QComboBox:focus {
    border-color: $accent;
}

QComboBox:disabled {
    background-color: transparent;
    color: $disabled;
    border: 1px dashed $disLine;
}

QComboBox:editable {
    padding-left: 6px;
    min-width: 120px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    right: 4px;
}

QComboBox::down-arrow {
    image: url(":/uitheme/ui/chevron-down.svg");
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:disabled {
    image: url(":/uitheme/ui/chevron-down-disabled.svg");
}

QComboBox QAbstractItemView,
QDialog QComboBox QAbstractItemView {
    background-color: $card;
    border: none;
    border-radius: 0;
    padding: 4px;
    margin: 0;
    outline: none;
    selection-background-color: $sel;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 2px 10px;
    margin: 1px 0;
    border-radius: 7px;
    color: $text;
}

QComboBox QAbstractItemView::item:hover {
    background-color: $hover;
}

QComboBox QAbstractItemView::item:selected {
    background-color: $sel;
}

/* ---------------------------------------------------- check / radio boxes */

QCheckBox,
QRadioButton {
    spacing: 8px;
    background: transparent;
    min-height: 20px;  /* 16px box + 1px border each side: never clipped */
}

QDialog QCheckBox,
QDialog QRadioButton {
    padding: 3px 0;
    margin-right: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    background-color: $field;
    border: 1px solid $boxLine;
    border-radius: 5px;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
    border-color: $accent;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    background-color: $accent;
    border-color: $accent;
    image: url(":/uitheme/ui/check.svg");
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    background-color: $accent;
    border-color: $accent;
    image: url(":/uitheme/ui/dash.svg");
}

QCheckBox::indicator:checked:hover:enabled,
QGroupBox::indicator:checked:hover:enabled,
QAbstractItemView::indicator:checked:hover:enabled {
    background-color: $accentHover;
    border-color: $accentHover;
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled {
    background-color: transparent;
    border-color: $line;
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    background-color: $line;
    border-color: $line;
    image: url(":/uitheme/ui/check-disabled.svg");
}

QRadioButton::indicator {
    background-color: $field;
    border: 1px solid $boxLine;
    border-radius: 9px;
}

QRadioButton::indicator:hover {
    border-color: $accent;
}

QRadioButton::indicator:checked {
    background-color: $accent;
    border-color: $accent;
    image: url(":/uitheme/ui/radio-dot.svg");
}

QRadioButton::indicator:disabled {
    background-color: transparent;
    border-color: $line;
}

/* ------------------------------------------------------------- group box */

/* group boxes are the dialogs' cards, their title above the card */
QGroupBox {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    margin-top: 24px;
    padding: 10px 12px 8px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    top: 2px;
    padding: 0 4px;
    color: $text;
    background: transparent;
}

QGroupBox:disabled::title {
    color: $disabled;
}

/* top-level section card: title 8px above the card, contents 21px in */
QDialog QGroupBox {
    margin-top: 44px;
    padding: 12px;
    font-size: 10.5pt;
    font-weight: 700;
}

QDialog QGroupBox::title {
    left: 21px;
    top: 18px;
    padding: 0;
}

QDialog QGroupBox QWidget {
    font-weight: normal;
}

/* a group box inside a card is a sub-section: no fill, title on the card's
   content edge, contents indented to where checkbox text starts (26px) */
QDialog QGroupBox QGroupBox {
    background-color: transparent;
    border: none;
    border-radius: 0;
    margin-top: 16px;
    padding: 0 0 0 17px;
    font-size: 9pt;
    font-weight: 700;
}

QDialog QGroupBox QGroupBox[checkable="false"]::title {
    color: $text2;
}

QDialog QGroupBox QGroupBox::title {
    left: 0;
    top: 0;
    spacing: 4px;
}

QDialog QGroupBox QGroupBox[checkable="true"] {
    font-size: 10pt;
    font-weight: normal;
    margin-top: 19px;
}

/* the 18px check box lives in the title band: give it the full height so its
   top border is never clipped by the group's edge */
QDialog QGroupBox QGroupBox[checkable="true"]::title {
    top: 1px;
}

/* a checkable group's title is a check box: same 8px box-to-text gap as one */
/* a checkable sub-section title is a check box: its text must start where a
   check box's text starts (box + 8px). Qt adds 4px of its own to group titles
   here, hence 4; the Search page's group adds 2. Measured, not guessed. */
QDialog QGroupBox QGroupBox[checkable="true"]::title {
    spacing: 4px;
    padding: 0;
}

QDialog QGroupBox QGroupBox#groupStoreSearchJobs::title {
    spacing: 6px;
}

QDialog QLabel {
    margin-right: 6px;
}

/* Fixed-size icon QLabels inside dialogs must not lose width to QDialog QLabel's
   right margin (which otherwise slices 4-6px off their right edge). */
DeletionConfirmationDialog #labelWarning,
AutomatedRssDownloader #labelMustStat,
AutomatedRssDownloader #labelMustNotStat,
AutomatedRssDownloader #labelEpFilterStat,
AutomatedRssDownloader #lblEFilterStat,
ShutdownConfirmDialog #warningLabel {
    margin-right: 0;
}

/* ---------------------------------------------------------------- slider */

QSlider::groove:horizontal {
    height: 4px;
    background-color: $line;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: $accent;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: $card;
    border: 1px solid $boxLine;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: $line;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: $card;
    border: 1px solid $boxLine;
    width: 14px;
    height: 14px;
    margin: 0 -6px;
    border-radius: 8px;
}

/* ----------------------------------------------------------- misc frames */

QToolTip {
    background-color: $card;
    color: $text;
    border: none;
    border-radius: 0;
    padding: 6px 8px;
}

QFrame[frameShape="HLine"],
QFrame[frameShape="4"] {
    border: none;
    background-color: $line2;
    max-height: 1px;
}

QFrame[frameShape="VLine"],
QFrame[frameShape="5"] {
    border: none;
    background-color: $line2;
    max-width: 1px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel {
    background: transparent;
}

QSizeGrip {
    image: none;
    width: 0;
    height: 0;
}

/* ============================================================ OPTIONS etc == */

OptionsDialog {
    min-width: 1000px;
    min-height: 700px;
}

/* the page list: qBittorrent sets each entry's height in code, so the grid
   gives the rows a 40px pitch and the margins draw a 34px pill in each */
OptionsDialog QListWidget {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    /* 2px + the item's 4px top margin = 6px above the first pill, the same as
       its left and right */
    padding: 2px 6px 6px 6px;
    min-width: 132px;
    max-width: 132px;
    qproperty-iconSize: 20px 20px;
    qproperty-viewMode: ListMode;
    qproperty-gridSize: 132px 40px;
    /* level with the first card, so the selected page and the first heading
       share a centre line */
    margin-top: 0;
}

OptionsDialog QListWidget::item {
    padding: 0 10px;
    border-radius: 8px;
    margin: 4px 0 25px 0;
    color: $text;
}

OptionsDialog QSplitter::handle {
    background-color: $canvas;
}

/* the page's own 9px layout margin + 1px handle = 10px from the page list to
   the cards, the same as between two cards and between the buttons */
OptionsDialog QSplitter {
    qproperty-handleWidth: 1;
}

/* OK / Cancel / Apply: 6px below the pages by default; 4px more = 10.
   The layout's 6px between buttons + 2 + 2 = 10 apart, and the 2px on the
   right puts Apply's right edge level with the scroll bar's */
OptionsDialog QDialogButtonBox QPushButton {
    margin-top: 4px;
    margin-left: 2px;
    margin-right: 2px;
}

OptionsDialog QListWidget::item:selected {
    background-color: $sel;
}

OptionsDialog QListWidget::item:hover:!selected {
    background-color: $hover;
}

OptionsDialog QScrollArea > QWidget > QWidget,
OptionsDialog QStackedWidget,
OptionsDialog QStackedWidget > QWidget,
OptionsDialog QStackedWidget QScrollArea > QWidget {
    background: transparent;
}

/* ---- Options pages: titled section cards ---------------------------------
   The page itself has no surface; each section is its own card with its
   heading inside. One spacing unit, 18px, measured to what you SEE (a field's
   box, a check box's square, the heading's letters):
     card edge -> content .. 18 on all four sides
     card -> card .......... 10   (= page list -> cards, button gaps)
     heading -> content .... 12
     row pitch ............. 40   (control 32 drawn, 8 between drawn boxes)
     sub-heading ........... 16 above, 8 below
   Group layouts add a fixed 9px inner margin and every row control a 1px
   margin; the paddings below subtract those. A check box row carries 8px of
   empty space under its square, so cards that end on one get less padding. */
/* -9px on top hides the page layout's empty 9px top margin, so the first
   card starts at the dialog's 11px margin like the page list */
OptionsDialog QStackedWidget QScrollArea {
    background: transparent;
    border: none;
    padding: 0;
    margin-top: -9px;
}

OptionsDialog QScrollArea QComboBox,
OptionsDialog QScrollArea QLineEdit,
OptionsDialog QScrollArea QAbstractSpinBox,
OptionsDialog QScrollArea QPushButton {
    min-height: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-top: 1px;
    margin-bottom: 1px;
}

OptionsDialog QScrollArea QCheckBox,
OptionsDialog QScrollArea QRadioButton {
    min-height: 20px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-top: 1px;
    margin-bottom: 1px;
}

/* rate and time spin boxes ask Qt for a taller box (∞ glyph, time sections);
   hold them to the same 32px */
OptionsDialog QScrollArea QAbstractSpinBox {
    max-height: 18px;
}

/* section card: heading box 16 down (its letters start 18 down) + 19 + 12 =
   47 to the first drawn control, less the 9px layout margin and 1px row
   margin = 37 on top; 9 + 9 = 18 at the sides; 1 + 9 + 8 = 18 below a field.
   2px above and below each card + the layout's 6px spacing = 10 between
   cards (= page list -> cards, button -> button); a loose
   row between cards gets 2-3 + 6 + its 1px margin on each side. */
OptionsDialog QScrollArea QGroupBox {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    margin: 2px 0 2px 0;
    padding: 37px 9px 8px 9px;
}

OptionsDialog QScrollArea QGroupBox::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    top: 16px;
    left: 18px;
}

/* cards whose last row is check boxes or text (8-9px of empty space under
   it) or a sub-section (its own 9px layout margin): 1px padding, so the
   visible gap is 18 */
OptionsDialog #groupBox_4,
OptionsDialog #boxTorrentContent,
OptionsDialog #statusBarGroup,
OptionsDialog #systrayBox,
OptionsDialog #groupBox,
OptionsDialog #torrentAdditionBox,
OptionsDialog #ListeningPortBox,
OptionsDialog #groupI2P,
OptionsDialog #groupProxy,
OptionsDialog #groupIPFilter,
OptionsDialog #altRateLimitBox,
OptionsDialog #rateLimitsGroupBox,
OptionsDialog #AddBTFeaturesBox,
OptionsDialog #checkEnableQueueing,
OptionsDialog #groupSearchUI,
OptionsDialog #checkWebUI {
    padding-bottom: 1px;
}

/* the scroll bar starts level with the first card's top edge (the same 9px
   layout margin the cards have) and ends level with the page list's bottom */
OptionsDialog QStackedWidget QScrollArea QScrollBar:vertical {
    margin: 9px 2px 1px 0;
}

/* the first card on each page starts at the top of the page (Connection
   starts with a loose row, so its first card keeps the gap) */
OptionsDialog #UISettingsBox,
OptionsDialog #torrentAdditionBox,
OptionsDialog #rateLimitBox,
OptionsDialog #AddBTFeaturesBox,
OptionsDialog #groupRSSReader,
OptionsDialog #groupSearchUI,
OptionsDialog #checkWebUI {
    margin-top: 0;
}

/* settings outside any section sit between the cards, lined up with the
   cards' contents (18px in) */
OptionsDialog QScrollArea > QWidget > QWidget > QCheckBox,
OptionsDialog QScrollArea > QWidget > QWidget > QRadioButton,
OptionsDialog QScrollArea > QWidget > QWidget > QLabel {
    margin-left: 18px;
}

/* sub-heading inside a card: no surface of its own. 1 row margin + 6 spacing
   + 9 = 16 above its text, which is 16px tall; 23 + 9 + 1 - 25 = 8 below */
OptionsDialog QScrollArea QGroupBox QGroupBox {
    background-color: transparent;
    border: none;
    border-radius: 0;
    margin-top: 23px;
    margin-bottom: 0;
    padding: 0;
}

OptionsDialog QScrollArea QGroupBox QGroupBox::title {
    subcontrol-origin: margin;
    top: 9px;
    left: 0;
}

/* a checkable sub-section behaves like one more row: its check box title is
   centred in a 34px row slot and its contents start one 40px pitch below */
OptionsDialog QScrollArea QGroupBox QGroupBox[checkable="true"] {
    margin-top: 31px;
}

OptionsDialog QScrollArea QGroupBox QGroupBox[checkable="true"]::title {
    top: 7px;
}

/* label columns: "Language" shares the Style / Color scheme column */
OptionsDialog #labelLanguage {
    min-width: 97px;
}

/* Downloads > "Automatically add torrents from": a rounded field like the rest */
OptionsDialog QTreeView#scanFoldersView {
    background-color: $field;
    border: 1px solid $line;
    border-radius: 10px;
    padding: 4px;
}

OptionsDialog QTreeView#scanFoldersView QHeaderView,
OptionsDialog QTreeView#scanFoldersView QHeaderView::section {
    background-color: transparent;
}

/* the same 9px offset as the cards on the other pages: level with the page
   list at the top, 11px from it at the side */
OptionsDialog AdvancedSettings {
    margin: 0 0 0 9px;
}

QDialog QWidget AdvancedSettings {
    background-color: $card;
    alternate-background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    padding: 8px;
    gridline-color: $line2;
}

/* row height: the table's (hidden) vertical header sets it; Qt's 30px stacked the
   fields into one block. 38px gives each field 8px above and below */
AdvancedSettings QHeaderView {
    qproperty-defaultSectionSize: 44;
    qproperty-minimumSectionSize: 44;
}

QDialog AdvancedSettings QHeaderView::section {
    border: none;
    border-bottom: 1px solid $line2;
    margin: 0;
    padding: 6px 8px 8px 8px;
}

/* Qt places these editors 4px below the row's top line; 4px more puts the 21px
   field in the middle of the 38px row. The bottom margin keeps drop-downs
   opening a few px below the field */
AdvancedSettings QAbstractSpinBox,
AdvancedSettings QComboBox,
AdvancedSettings QLineEdit {
    padding-top: 1px;
    padding-bottom: 0;
    margin: 5px 0 7px 0;
    min-height: 24px;
    max-height: 24px;
}

AdvancedSettings QCheckBox {
    padding: 0;
    margin: 4px 0 0 0;
}

/* a settings form, not a list: no square cell blocks on hover or click (the
   fields show their own hover border) */
QDialog AdvancedSettings::item:hover,
QDialog AdvancedSettings::item:selected {
    background-color: transparent;
    color: $text;
}

LogListView,
ExecutionLogWidget QListView {
    background-color: $card;
    border: none;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: $card;
}

QCalendarWidget QAbstractItemView {
    border: none;
    border-radius: 0;
}

/* =============================================================== POPUPS == */
/* Every drop-down opens 6px below its control. Qt places a popup at the bottom
   of the widget's rect, margins included, so a 6px bottom margin is the gap. */

/* Speed tab: Period and Select Graphs */
SpeedWidget QComboBox {
    margin-bottom: 6px;
}

/* Select Graphs: as wide as its menu, so the menu opens flush under it and
   stays inside the window instead of running past the right edge */
SpeedWidget ComboBoxMenuButton {
    min-width: 140px;  /* 206px outer: exactly the menu's width, both edges flush */
}


/* ==================================================================== RSS == */
/* Reader: the feed tree, article list and preview are three cards like the
   transfer list. Rows are the sidebar's 32px pills, which also keeps the
   Windows 11 style from painting its selection bar in the indent. */

RSSWidget #feedListWidget,
RSSWidget #articleListWidget {
    background-color: $card;
    alternate-background-color: $card;
    border: 1px solid $line;
    border-radius: 14px;
    padding: 4px 0 6px 0;
    qproperty-iconSize: 16px 16px;
    show-decoration-selected: 1;
}

/* long titles elide instead of growing a sideways scroll bar */
RSSWidget #articleListWidget {
    qproperty-horizontalScrollBarPolicy: ScrollBarAlwaysOff;
    qproperty-textElideMode: ElideRight;
}

/* no 'color' on article rows: read/unread colours come from config.json
   (RSS.ReadArticle / RSS.UnreadArticle) */
RSSWidget #feedListWidget::item,
RSSWidget #articleListWidget::item {
    background: transparent;
    border: none;
    border-radius: 8px;
    height: 22px;
    padding: 5px 10px;
    margin: 1px 8px;
}

RSSWidget #feedListWidget::item {
    color: $text;
    margin-left: 0;
}

/* the indent never shows selection: that is where the Windows 11 style paints
   its accent bar; the card's top drops by the caption's height so all three
   cards start on one line */
RSSWidget #feedListWidget {
    show-decoration-selected: 0;
    margin-top: 26px;
}

RSSWidget #feedListWidget::item:hover,
RSSWidget #articleListWidget::item:hover {
    background-color: $hover;
}

RSSWidget #feedListWidget::item:selected,
RSSWidget #articleListWidget::item:selected {
    background-color: $sel;
}

/* opaque: Qt paints the row panel (and Windows 11 its accent bar) under the
   indent first; the card colour covers it */
RSSWidget #feedListWidget::branch,
RSSWidget #feedListWidget::branch:hover,
RSSWidget #feedListWidget::branch:selected {
    background-color: $card;
}

/* "RSS feeds" header: the transfer list's header line, no sort mark */
RSSWidget #feedListWidget QHeaderView {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid $line;
    margin-bottom: 4px;
}

RSSWidget #feedListWidget QHeaderView::section {
    color: $text;
    font-weight: 500;
    font-size: 9pt;
    border: none;
    margin: 10px 0 6px 0;
    padding: 0 14px;
}

RSSWidget #feedListWidget QHeaderView::up-arrow,
RSSWidget #feedListWidget QHeaderView::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* scroll bars in their own lane along the card edge, as in the transfer list */
RSSWidget #feedListWidget QScrollBar:vertical,
RSSWidget #articleListWidget QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 10px;
    margin: 0;
    padding: 4px 1px 4px 1px;
}

RSSWidget #feedListWidget QScrollBar::handle,
RSSWidget #articleListWidget QScrollBar::handle {
    border-radius: 4px;
}

/* "Torrents: (double-click to download)": a caption over the two right cards,
   on the same line as the "RSS feeds" title inside the left card */
RSSWidget #news_lbl {
    color: $text2;
    font-size: 9pt;
    font-weight: 500;
    padding: 0 0 6px 14px;
}

/* Preview. qBittorrent builds the article's title bar and info rows from this
   widget's Highlight / HighlightedText / AlternateBase colours, read with
   QColor::name(), which drops alpha, so these must be solid colours. */
RSSWidget #textBrowser {
    background-color: $card;
    border: 1px solid $line;
    border-radius: 14px;
    padding: 10px 12px;
    selection-background-color: $selSolid;
    selection-color: $text;
    alternate-background-color: $card;
}

/* ========================================================= RSS DOWNLOADER == */

/* room for the rule editor: its rows need ~610px, so the middle column never
   clips or scrolls sideways, and the buttons always fit below the columns */
AutomatedRssDownloader {
    min-width: 1180px;
    min-height: 760px;
}

AutomatedRssDownloader #ruleScrollArea {
    min-width: 640px;
    qproperty-horizontalScrollBarPolicy: ScrollBarAlwaysOff;
}

AutomatedRssDownloader #ruleList,
AutomatedRssDownloader #listFeeds,
AutomatedRssDownloader #matchingArticlesTree {
    background-color: $card;
    alternate-background-color: $card;
    border: 1px solid $line;
    border-radius: 12px;
    padding: 4px 0;
    show-decoration-selected: 1;
}

AutomatedRssDownloader #ruleList::item,
AutomatedRssDownloader #listFeeds::item,
AutomatedRssDownloader #matchingArticlesTree::item {
    color: $text;
    background: transparent;
    border: none;
    border-radius: 8px;
    height: 22px;
    padding: 5px 8px;
    margin: 1px 6px;
}

AutomatedRssDownloader #matchingArticlesTree::item {
    margin-left: 0;
}

AutomatedRssDownloader #ruleList::item:hover,
AutomatedRssDownloader #listFeeds::item:hover,
AutomatedRssDownloader #matchingArticlesTree::item:hover {
    background-color: $hover;
}

AutomatedRssDownloader #ruleList::item:selected,
AutomatedRssDownloader #listFeeds::item:selected,
AutomatedRssDownloader #matchingArticlesTree::item:selected {
    background-color: $sel;
}

AutomatedRssDownloader #matchingArticlesTree::branch,
AutomatedRssDownloader #matchingArticlesTree::branch:selected {
    background-color: transparent;
}

/* column titles: one caption style, level with the rule list's tool buttons */
AutomatedRssDownloader #ruleListLabel,
AutomatedRssDownloader #lblListFeeds,
AutomatedRssDownloader #matchingArticlesLabel {
    color: $text2;
    font-size: 9pt;
    font-weight: 500;
    padding-left: 4px;
}

/* Import / Export are ordinary buttons; focus must not make them look primary */
AutomatedRssDownloader #importBtn:default,
AutomatedRssDownloader #exportBtn:default {
    background-color: $card;
    border-color: $line;
    color: $text;
    font-weight: $bodyWeight;
}

AutomatedRssDownloader #importBtn:default:hover,
AutomatedRssDownloader #exportBtn:default:hover {
    background-color: $hover;
}

/* "Matching RSS Articles" takes the height of the rule list's tool-button row,
   so both lists start on one line */
AutomatedRssDownloader #matchingArticlesLabel {
    min-height: 33px;
    max-height: 33px;
}

/* ========================================================= TORRENT CREATOR == */
/* The cards fill the scroll area, so the scroll bar sat flush on their right
   edge. The gap belongs to the bar instead: its lane carries 11px on its left
   and none on its right, so with a bar it reads 11 | cards | 11 | bar | 11
   (the layout's own margin), and without one the cards sit 11px from both
   edges. The progress bar below ends level with either. */
TorrentCreatorDialog QScrollBar:vertical {
    width: 19px;  /* Qt counts the margin inside the width: 11 + an 8px thumb */
    margin: 3px 0 3px 11px;
}

/* ---- Torrent Creator, balanced (2026-11-19)
   One label column for every row (Path, Torrent format, Piece size, the four
   fields and Progress), so every input starts on the same vertical line; the
   drop area reads as a drop zone; the progress bar is a soft pill; the buttons
   sit on the right like every other Noorjahan dialog. */
TorrentCreatorDialog #label,
TorrentCreatorDialog #labelTorrentFormat,
TorrentCreatorDialog #txtPieceSize,
TorrentCreatorDialog #lbl_announce_url,
TorrentCreatorDialog #urlSeeds_lbl,
TorrentCreatorDialog #lbl_comment,
TorrentCreatorDialog #labelSource {
    min-width: 106px;
    max-width: 106px;
    color: $text2;
}

/* multi-line fields: the label sits on the first line, not in the middle */
TorrentCreatorDialog #lbl_announce_url,
TorrentCreatorDialog #urlSeeds_lbl,
TorrentCreatorDialog #lbl_comment {
    qproperty-alignment: 'AlignLeft | AlignTop';
    padding-top: 7px;
}

TorrentCreatorDialog #comboTorrentFormat,
TorrentCreatorDialog #comboPieceSize {
    min-width: 92px;
    max-width: 92px;
}

TorrentCreatorDialog #labelTotalPieces {
    color: $text2;
}

/* the drag-and-drop hint becomes a real drop zone, as tall as the buttons */
TorrentCreatorDialog #label_2 {
    border: 1px dashed $lineStrong;
    border-radius: 8px;
    color: $text3;
    min-height: 30px;
    max-height: 30px;
    margin-right: 4px;
    padding: 0 10px;
}

TorrentCreatorDialog #trackersList,
TorrentCreatorDialog #URLSeedsList,
TorrentCreatorDialog #txtComment {
    min-height: 64px;
}

/* progress: a soft pill with the label column in front of it */
TorrentCreatorDialog #progressLbl {
    min-width: 106px;
    max-width: 106px;
    padding-left: 22px;
    color: $text2;
}

TorrentCreatorDialog QProgressBar {
    background-color: $groove;
    border: none;
    border-radius: 9px;
    min-height: 18px;
    max-height: 18px;
    color: $text2;
    text-align: center;
}

TorrentCreatorDialog QProgressBar::chunk {
    background-color: $accentLine;
    border-radius: 9px;
}

TorrentCreatorDialog QDialogButtonBox {
    qproperty-centerButtons: false;
}

TorrentCreatorDialog QDialogButtonBox QPushButton {
    margin-top: 6px;
    min-width: 96px;
}


/* ======================================================= ADD NEW TORRENT == */

/* file tree: the details panel's rows. The expand-arrow column is painted with
   the card, otherwise the Windows 11 style draws its own grey selection box and
   accent bars there, beside a square row highlight */
AddNewTorrentDialog QTreeView {
    show-decoration-selected: 0;
}

AddNewTorrentDialog QTreeView::branch,
AddNewTorrentDialog QTreeView::branch:hover,
AddNewTorrentDialog QTreeView::branch:selected {
    background-color: $card;
}

AddNewTorrentDialog QTreeView::item:first {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

AddNewTorrentDialog QTreeView::item:last {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

AddNewTorrentDialog QTreeView::item:only-one {
    border-radius: 8px;
}

/* header as in the details panel: a line under it, thin column dividers */
/* the header's height is its own: section paddings don't grow it, so without
   this the descenders of "Download Priority" are cut */
AddNewTorrentDialog QHeaderView {
    border: none;
    border-bottom: 1px solid $line;
    margin-bottom: 4px;
    min-height: 34px;
    max-height: 34px;
}

AddNewTorrentDialog QHeaderView::section {
    border: none;
    border-right: 1px solid $colsep;
    margin: 6px 0;
    padding: 0 8px;
}

AddNewTorrentDialog QHeaderView::section:last {
    border-right: none;
}

/* Tags: qBittorrent's placeholder says "Click [...] button", so the button keeps
   its "..." and gets the field look: 32px square, outlined, beside the field */
AddNewTorrentDialog #tagsEditButton {
    background-color: $field;
    border: 1px solid $line;
    border-radius: 9px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 0 4px 0;
    font-weight: 600;
    color: $text2;
}

AddNewTorrentDialog #tagsEditButton:hover {
    background-color: $hover;
    border-color: $lineStrong;
    color: $text;
}
